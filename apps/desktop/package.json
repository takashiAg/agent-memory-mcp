{
  "name": "@agent-memory-mcp/desktop",
  "version": "1.0.0",
  "private": true,
  "description": "Menu bar desktop app for agent-memory-mcp.",
  "main": "main.cjs",
  "scripts": {
    "dev": "npm run build --workspace @agent-memory-mcp/core && electron .",
    "sync-dist": "node scripts/sync-dist.cjs",
    "dist": "npm run build --workspace @agent-memory-mcp/core && npm run sync-dist && electron-builder"
  },
  "dependencies": {
    "@agent-memory-mcp/core": "1.0.0"
  },
  "devDependencies": {
    "electron": "^35.7.5",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "dev.agent-memory-mcp.menubar",
    "productName": "Agent Memory",
    "files": [
      "main.cjs",
      "preload.cjs",
      "vendor/core/**",
      "renderer/**",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ]
    }
  }
}
