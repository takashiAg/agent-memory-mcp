{
  "name": "agent-memory-mcp-workspace",
  "version": "1.0.0",
  "private": true,
  "description": "The Model 型 SaaS の業務文脈を、Codex や Claude Code などの MCP 対応エージェントへ引き継ぐためのローカルメモリです。",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "inspect": "npm run inspect --workspace agent-memory-mcp --",
    "app": "npm run dev --workspace @agent-memory-mcp/desktop",
    "app:build": "npm run dist --workspace @agent-memory-mcp/desktop",
    "lint:md": "markdownlint-cli2 \"**/*.md\" \"#node_modules\"",
    "typecheck": "npm run build --workspace @agent-memory-mcp/core && npm run typecheck --workspaces --if-present",
    "start": "npm run start --workspace agent-memory-mcp"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/takashiAg/agent-memory-mcp.git"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/takashiAg/agent-memory-mcp/issues"
  },
  "homepage": "https://github.com/takashiAg/agent-memory-mcp#readme",
  "devDependencies": {
    "@types/node": "^25.6.0",
    "markdownlint-cli2": "^0.22.1",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
